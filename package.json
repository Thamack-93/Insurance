    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.16.1",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "parse5": "^7.3.0",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.21.0",
    "react": "^19.2.4",
