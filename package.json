    "configure:pedro-organization": "node --import tsx scripts/configure-pedro-organization.ts",
    "backups:attribute-legacy": "node --import tsx scripts/attribute-legacy-backups.ts",
    "check:tenant-backfill": "node --import tsx scripts/check-tenant-backfill.ts",
    "check:tenant-guards": "node --import tsx scripts/check-tenant-inventory.ts && node --import tsx scripts/check-tenant-backfill.ts --guards-only && npm run check:activity-log-scope",
    "check:multi-org-audit": "node --import tsx scripts/check-multi-org-audit.ts",
    "cutover:multi-org": "node --import tsx scripts/cutover-multi-org.ts",
