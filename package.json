{
  "name": "policydesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "npm run db:generate && next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node -e \"require('node:fs').rmSync('src/generated/prisma',{recursive:true,force:true})\" && prisma generate && node -e \"require('node:fs').mkdirSync('src/generated/prisma',{recursive:true});require('node:fs').writeFileSync('src/generated/prisma/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "db:migrate": "prisma migrate dev",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "backfill:organizations": "node --import tsx scripts/backfill-organizations.ts",
    "check:tenant-backfill": "node --import tsx scripts/check-tenant-backfill.ts",
    "check:tenant-guards": "node --import tsx scripts/check-tenant-inventory.ts && node --import tsx scripts/check-tenant-backfill.ts --guards-only",
    "provision:platform-admin": "node --import tsx scripts/provision-platform-admin.ts",
    "db:sync-work-items": "tsx scripts/backfill-work-items.ts",
    "clean:cache": "node --import tsx scripts/clean-cache.ts cache",
    "clean:artifacts": "node --import tsx scripts/clean-cache.ts artifacts",
    "validate-data": "tsx scripts/validate-data-quality.ts",
    "report:birthday-coverage": "tsx scripts/report-birthday-coverage.ts",
    "import:approved-birthdays": "tsx scripts/import-approved-birthdays.ts",
    "reconcile:insured-clients": "tsx scripts/reconcile-insured-clients.ts",
    "check:legacy-workitem-refs": "node --import tsx scripts/check-legacy-workitem-refs.ts",
    "check:qualification-scope": "node scripts/check-qualification-scope.mjs",
    "check:navigation": "node scripts/check-navigation-reachability.mjs",
    "list:payments": "tsx scripts/list-next-payments.ts",
    "list:renewals": "tsx scripts/list-renewals.ts",
    "audit:renewals": "tsx scripts/audit-renewal-consistency.ts",
    "list:work-items": "tsx scripts/list-open-work-items.ts",
    "reconcile:receipts": "tsx scripts/reconcile-receipt-statuses.ts",
    "maintenance:historical-receipts": "tsx scripts/apply-historical-receipts.ts",
    "maintenance:business-dates": "tsx scripts/backfill-business-dates.ts",
    "maintenance:preview-policy-work": "node --import tsx scripts/preview-policy-maintenance.ts",
    "pdf:lab": "tsx scripts/pdf-extraction-lab.ts",
    "assign:portfolio": "tsx scripts/assign-existing-portfolio.ts",
    "export:due-payments": "tsx scripts/export-due-payments.ts",
    "export:commissions": "tsx scripts/export-commissions.ts",
    "import:policy-ledger": "tsx scripts/import-policy-ledger.ts",
    "restore:backup:temp-neon": "tsx scripts/restore-backup-to-neon-branch.ts",
    "drill:backup:temp-neon": "tsx scripts/run-backup-restore-drill.ts",
    "split:policy-vigencies": "tsx scripts/split-policy-vigencies.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api"
    ,"test:tenant-fixture": "node --import tsx scripts/setup-tenant-isolation-fixture.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@e965/xlsx": "^0.20.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.20.0",
    "@vercel/blob": "^2.5.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.16.1",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.2"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^1.19.13",
    "@ts-morph/common": {
      "brace-expansion": "^5.0.7"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "^5.0.7"
    },
    "esbuild": "^0.28.1",
    "express-rate-limit": "^8.5.2",
    "fast-uri": "^3.1.3",
    "hono": "^4.12.27",
    "ip-address": "^10.2.0",
    "js-yaml": "^4.3.0",
    "postcss": "^8.4.32",
    "qs": "^6.15.3",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "prisma": "^7.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
