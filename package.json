    "check:api-security": "node scripts/check-api-security-manifest.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:server-actions": "node scripts/check-server-actions.mjs",
    "check:activity-log-scope": "node --import tsx scripts/check-activity-log-scope.ts",
