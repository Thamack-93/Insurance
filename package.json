    "drill:backup:temp-neon": "tsx scripts/run-backup-restore-drill.ts",
    "import:organization:production": "node --import tsx scripts/import-organization-backup.ts",
    "split:policy-vigencies": "tsx scripts/split-policy-vigencies.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:tenant-fixture": "node --import tsx scripts/setup-tenant-isolation-fixture.ts",
    "test:tenant-rls": "node --import tsx scripts/test-tenant-rls.ts",
    "certify:tenant-rls": "node --import tsx scripts/certify-tenant-rls.ts",
    "backup:create:platform": "node --import tsx scripts/create-platform-backup.ts",
    "backup:create:organization": "node --import tsx scripts/create-organization-backup.ts",
    "validate:demo-upload": "node --import tsx scripts/validate-demo-upload.ts"
