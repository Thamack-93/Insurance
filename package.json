{
  "name": "policydesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node -e \"require('node:fs').rmSync('src/generated/prisma',{recursive:true,force:true})\" && prisma generate && node -e \"require('node:fs').mkdirSync('src/generated/prisma',{recursive:true});require('node:fs').writeFileSync('src/generated/prisma/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "backup": "tsx scripts/backup-db.ts",
    "db:sync-work-items": "tsx scripts/backfill-work-items.ts",
    "clean:cache": "node --import tsx scripts/clean-cache.ts cache",
    "clean:artifacts": "node --import tsx scripts/clean-cache.ts artifacts",
    "validate-data": "tsx scripts/validate-data-quality.ts",
    "check:legacy-workitem-refs": "node --import tsx scripts/check-legacy-workitem-refs.ts",
    "list:payments": "tsx scripts/list-next-payments.ts",
    "list:renewals": "tsx scripts/list-renewals.ts",
    "list:work-items": "tsx scripts/list-open-work-items.ts",
    "export:due-payments": "tsx scripts/export-due-payments.ts",
    "export:commissions": "tsx scripts/export-commissions.ts",
    "import:policy-ledger": "tsx scripts/import-policy-ledger.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@e965/xlsx": "^0.20.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.4.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
