# Copy to .env.local and adjust values.

# Required in production (min 32 characters). Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database URL for the deployed demo. Point this at your hosted Postgres.
DATABASE_URL=
# Direct administrative connection for migrations, cutover, backup/restore.
# Never expose this value to the application runtime.
DATABASE_ADMIN_URL=
# Read-only production verifier connection (recommended separate role).
PRODUCTION_READONLY_DATABASE_URL=
# Role used by the read-only verifier connection (required in multi-org mode).
PRODUCTION_READONLY_ROLE=

# Protects all Vercel Cron jobs: backup, nonpayment cancellation, renewal
# follow-ups, DEMO retention and Telegram digest/birthdays.
CRON_SECRET=

# Distributed abuse protection is mandatory in production; local development
# may omit it and use the in-process fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Production must fail closed if the distributed limiter/lock is unavailable.
REQUIRE_DISTRIBUTED_RATE_LIMIT=1
SECURITY_EVENT_FINGERPRINT_SECRET=

# Vercel AI Gateway. Qwen 3.7 Flash is the Nora default; DeepSeek V4 Flash 0731
# and GPT-5.4 Nano are ordered fallbacks. Set a fallback variable to "none"
# to use only the selected model plus local fallback.
# AI_GATEWAY_API_KEY is the recommended credential for local / non-OIDC use.
AI_GATEWAY_MODEL=alibaba/qwen3.7-flash
AI_GATEWAY_FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731,openai/gpt-5.4-nano
AI_GATEWAY_STRUCTURED_MODEL=alibaba/qwen3.7-flash
AI_GATEWAY_STRUCTURED_FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731,openai/gpt-5.4-nano
AI_GATEWAY_API_KEY=
# Hybrid Nora rollout. Only an explicit value activates the orchestrator; a
# missing, blank or invalid value always resolves to off, regardless of Vercel.
NORA_AGENT_MODE=off
# PolicyDesk-local soft limit; this does not replace the Vercel team budget.
NORA_AI_MONTHLY_SOFT_LIMIT_USD=4
# Optional emergency guards. Nora normally stops by steps, tokens and budget;
# the idle guard resets whenever the streamed provider emits progress.
NORA_AI_IDLE_TIMEOUT_MS=120000
NORA_AI_EMERGENCY_TIMEOUT_MS=240000

# Private Vercel Blob backup store and application-level encryption.
BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=v1
# One-off, server-side key migration. Keep disabled except while creating and
# verifying immutable copies of existing backups. Do not replace the active key
# until every required backup has a verified copy under the new version.
BACKUP_REKEY_ENABLED=false
BACKUP_REKEY_TARGET_KEY_VERSION=v2
# Keep each previous version only while backups encrypted with it still require
# restoration (for example, BACKUP_ENCRYPTION_KEY_V1 after switching to v2).
BACKUP_ENCRYPTION_KEY_V1=
BACKUP_ENCRYPTION_KEY_V2=

# CLI restore only. Point exclusively to a temporary Neon branch.
RESTORE_DATABASE_URL=
RESTORE_NEON_BRANCH=restore-example
ALLOW_TEMPORARY_NEON_RESTORE=false

# Multi-organization cutover/provisioning. Keep disabled until disposable-DB
# two-organization evidence and RLS checks are complete.
PRODUCTION_EXPECTED_TENANT_MODE=single-org
ENABLE_TENANT_RLS_CUTOVER=0
TENANT_RLS_APP_ROLE=policydesk_app
# Disposable certification only: the orchestrator uses this to provision the
# app-role password on a local PostgreSQL fixture. Never commit or put it in a
# Vercel runtime environment.
TENANT_RLS_APP_PASSWORD=
TENANT_RLS_PLATFORM_OWNER_ROLE=policydesk_platform_owner
PLATFORM_ORG_PROVISIONING_ENABLED=0
# Paid CUSTOMER onboarding remains disabled until the commercial release.
PLATFORM_CUSTOMER_PROVISIONING_ENABLED=0
ALLOW_TENANT_PRODUCTION_IMPORT=0

# Platform kill switches. Any explicit "0" disables the capability globally;
# an organization plan/override can never re-enable it.
PLATFORM_NORA_ENABLED=1
PLATFORM_IMPORTS_ENABLED=1
PLATFORM_EXPORTS_ENABLED=1
PLATFORM_UPLOADS_ENABLED=1
PLATFORM_EMAIL_ENABLED=1
PLATFORM_TELEGRAM_ENABLED=1
PLATFORM_WHATSAPP_ENABLED=1
PLATFORM_QUALITAS_ENABLED=0
QUALITAS_PRODUCTION_CERTIFIED=0

# Optional application smoke after a successful restore drill. Never point this
# at production; the drill creates and removes a temporary fixture user.
RESTORE_DRILL_APP_SMOKE=0

# Ledger CLI safety. Production apply remains blocked unless explicitly overridden.
PLATFORM_BILLING_MUTATIONS_ENABLED=0
POLICY_LEDGER_TARGET_ENV=preview
ALLOW_POLICY_LEDGER_PRODUCTION_APPLY=0

# Generic label for one-off mutating scripts. Use an explicit non-production target.
SCRIPT_TARGET_ENV=development

# Telegram bot credentials for the assisted operations layer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Quálitas payment-link request. Keep disabled until the authorized provider
# workflow discovery and controlled pilot have passed.
QUALITAS_PAYMENT_LINK_ENABLED=false
# Client recipient delivery stays disabled until both Agent pilot channels and
# duplicate handling are certified. This gate is subordinate to the flag above.
QUALITAS_PAYMENT_LINK_CLIENT_RECIPIENT_ENABLED=false

# Optional read-only Quálitas health check. Never enables final submission.
QUALITAS_FLOW_LIVE=0

# Public base URL used to build Telegram webhook URLs and notifications.
APP_BASE_URL=

# DEMO real-document uploads use private Vercel Blob objects and are purged
# after 48 hours. Keep the feature enabled only when BLOB_READ_WRITE_TOKEN is
# configured in the same environment.
ENABLE_DOCUMENT_FILES=true
NEXT_PUBLIC_DOCUMENT_FILES_ENABLED=1

# Nora browser handoff persistence. Set to false for an emergency rollback;
# Nora then keeps state in memory for the current tab only.
NEXT_PUBLIC_NORA_SESSION_PERSISTENCE=true

# Development alias for SESSION_SECRET (optional).
# AUTH_SECRET=
# Platform-wide SUPERADMIN provisioning. Password is required only when the
# account is created or explicitly rotated and must never be committed.
PLATFORM_ADMIN_EMAIL=admin@policydesk.local
PLATFORM_ADMIN_PASSWORD=
