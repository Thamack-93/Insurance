# Copy to .env.local and adjust values.

# Required in production (min 32 characters). Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database URL for the deployed demo. Point this at your hosted Postgres.
DATABASE_URL=

# Protects the single scheduled job shared by Telegram and backups.
CRON_SECRET=

# Vercel AI Gateway. Minimax M3 is primary; GPT-4o mini is the fallback model.
# AI_GATEWAY_API_KEY is the recommended credential for local / non-OIDC use.
AI_GATEWAY_MODEL=minimax/minimax-m3
AI_GATEWAY_FALLBACK_MODELS=openai/gpt-4o-mini
AI_GATEWAY_API_KEY=

# Private Vercel Blob backup store and application-level encryption.
BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=v1

# CLI restore only. Point exclusively to a temporary Neon branch.
RESTORE_DATABASE_URL=
RESTORE_NEON_BRANCH=restore-example
ALLOW_TEMPORARY_NEON_RESTORE=false

# Ledger CLI safety. Production apply remains blocked unless explicitly overridden.
POLICY_LEDGER_TARGET_ENV=preview
ALLOW_POLICY_LEDGER_PRODUCTION_APPLY=0

# Telegram bot credentials for the assisted operations layer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public base URL used to build Telegram webhook URLs and notifications.
APP_BASE_URL=

# File-backed documents are disabled in the Vercel demo v1.
ENABLE_DOCUMENT_FILES=false

# Development alias for SESSION_SECRET (optional).
# AUTH_SECRET=
