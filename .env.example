# Copy to .env.local and adjust values.

# Required in production (min 32 characters). Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database URL for the deployed demo. Point this at your hosted Postgres.
DATABASE_URL=

# Protects all four Vercel Cron jobs: backup, nonpayment cancellation,
# Telegram digest and Telegram birthdays.
CRON_SECRET=

# Optional distributed abuse protection. Leave disabled for the current single-user deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DISTRIBUTED_RATE_LIMIT=0
SECURITY_EVENT_FINGERPRINT_SECRET=

# Vercel AI Gateway. Qwen 3.7 Flash is the economical Nora default; DeepSeek
# V4 Flash is the only paid fallback for harder or failed requests. Set a
# fallback variable to "none" to use only the selected model plus local fallback.
# AI_GATEWAY_API_KEY is the recommended credential for local / non-OIDC use.
AI_GATEWAY_MODEL=alibaba/qwen3.7-flash
AI_GATEWAY_FALLBACK_MODELS=deepseek/deepseek-v4-flash
AI_GATEWAY_STRUCTURED_MODEL=alibaba/qwen3.7-flash
AI_GATEWAY_STRUCTURED_FALLBACK_MODELS=deepseek/deepseek-v4-flash
AI_GATEWAY_API_KEY=
# Hybrid Nora rollout. off keeps the current local-first behavior, admin pilots
# the AI tool orchestrator for administrators, and all enables it for agents.
NORA_AGENT_MODE=off
# PolicyDesk-local soft limit; this does not replace the Vercel team budget.
NORA_AI_MONTHLY_SOFT_LIMIT_USD=4
# Optional emergency guards. Nora normally stops by steps, tokens and budget;
# the idle guard resets whenever the streamed provider emits progress.
NORA_AI_IDLE_TIMEOUT_MS=120000
NORA_AI_EMERGENCY_TIMEOUT_MS=240000

# Private Vercel Blob backup store and application-level encryption.
BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=v1
# One-off, server-side key migration. Keep disabled except while creating and
# verifying immutable copies of existing backups. Do not replace the active key
# until every required backup has a verified copy under the new version.
BACKUP_REKEY_ENABLED=false
BACKUP_REKEY_TARGET_KEY_VERSION=v2
# Keep each previous version only while backups encrypted with it still require
# restoration (for example, BACKUP_ENCRYPTION_KEY_V1 after switching to v2).
BACKUP_ENCRYPTION_KEY_V1=
BACKUP_ENCRYPTION_KEY_V2=

# CLI restore only. Point exclusively to a temporary Neon branch.
RESTORE_DATABASE_URL=
RESTORE_NEON_BRANCH=restore-example
ALLOW_TEMPORARY_NEON_RESTORE=false

# Optional application smoke after a successful restore drill. Never point this
# at production; the drill creates and removes a temporary fixture user.
RESTORE_DRILL_APP_SMOKE=0

# Ledger CLI safety. Production apply remains blocked unless explicitly overridden.
POLICY_LEDGER_TARGET_ENV=preview
ALLOW_POLICY_LEDGER_PRODUCTION_APPLY=0

# Generic label for one-off mutating scripts. Use an explicit non-production target.
SCRIPT_TARGET_ENV=development

# Telegram bot credentials for the assisted operations layer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public base URL used to build Telegram webhook URLs and notifications.
APP_BASE_URL=

# File-backed documents are disabled in the Vercel demo v1.
ENABLE_DOCUMENT_FILES=false

# Nora browser handoff persistence. Set to false for an emergency rollback;
# Nora then keeps state in memory for the current tab only.
NEXT_PUBLIC_NORA_SESSION_PERSISTENCE=true

# Development alias for SESSION_SECRET (optional).
# AUTH_SECRET=
# Platform-wide SUPERADMIN provisioning. Password is required only when the
# account is created or explicitly rotated and must never be committed.
PLATFORM_ADMIN_EMAIL=admin@policydesk.local
PLATFORM_ADMIN_PASSWORD=
