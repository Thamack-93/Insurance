/// Reviewed insurer statement imported for commission reconciliation.
model CommissionStatement {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  sourceFileName String
  sourceFilePath String?
  mimeType       String
  sourceHash     String
  periodStart    DateTime?
  periodEnd      DateTime?
  status         String       @default("REVIEW")
  summaryJson    String?
  version        Int          @default(1)
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  appliedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy  User?                    @relation("CommissionStatementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?                    @relation("CommissionStatementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rows       CommissionStatementRow[]

  @@unique([organizationId, sourceHash])
  @@index([organizationId, status])
  @@index([organizationId])
  @@index([createdAt])
}

model CommissionStatementRow {
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                String       @id @default(cuid())
  statementId       String
  sourceRowKey      String
  sourcePage        Int?
  rawJson           String
  normalizedJson    String?
  policyNumber      String?
  receiptNumber     String?
  currency          String?
  amount            Decimal?
  paymentDate       DateTime?
  status            String       @default("REVIEW")
  matchReason       String?
  discrepancyReason String?
  commissionId      String?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  statement  CommissionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  commission Commission?         @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  corrections CommissionCorrection[]

  @@unique([statementId, sourceRowKey])
  @@index([organizationId, status])
  @@index([organizationId])
  @@index([commissionId])
  @@index([policyNumber])
  @@index([receiptNumber])
}

/// Immutable administrator correction linked to an original commission application.
model CommissionCorrection {
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                String @id @default(cuid())
  commissionId      String
  statementRowId    String?
  actorId           String
  reason            String
  priorValuesJson   String
  currentValuesJson String
  evidenceJson      String?
  version           Int @default(1)
  createdAt         DateTime @default(now())

  commission   Commission             @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  statementRow CommissionStatementRow? @relation(fields: [statementRowId], references: [id], onDelete: SetNull)
  actor        User                   @relation("CommissionCorrectionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, commissionId])
  @@index([organizationId, createdAt])
  @@index([statementRowId])
}

/// A reviewed set of alternative quotes for one client and product line.
model QuoteComparison {
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id              String       @id @default(cuid())
  clientId        String
  policyType      String
  status          String       @default("DRAFT")
  selectedQuoteId String?
  selectedAt      DateTime?
  selectionReason String?
  version         Int          @default(1)
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("QuoteComparisonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     QuoteComparisonItem[]

  @@index([organizationId, clientId])
  @@index([organizationId])
  @@index([status])
}

model QuoteComparisonItem {
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id               String       @id @default(cuid())
  comparisonId     String
  quoteId          String
  termsJson        String?
  sourceDocumentId String?
  reviewStatus     String       @default("REVIEW")
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  comparison QuoteComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  quote      Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, quoteId])
  @@index([organizationId])
  @@index([quoteId])
}
