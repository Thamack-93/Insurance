model PolicyRenewalSuggestion {
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                 String       @id @default(cuid())
  maintenanceRunId   String?
  sourcePolicyId     String
  targetPolicyId     String?
  status             String       @default("PENDING")
  confidence         Decimal?
  reason             String?
  suppressedByRuleId String?
  duplicateOfId      String?
  mergedAt           DateTime?
  mergedById         String?
  reviewedAt         DateTime?
  reviewedById       String?
  resolutionNote     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  maintenanceRun   MaintenanceRun?             @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  sourcePolicy     Policy                      @relation("PolicyRenewalSuggestionSource", fields: [sourcePolicyId], references: [id], onDelete: Cascade)
  targetPolicy     Policy?                     @relation("PolicyRenewalSuggestionTarget", fields: [targetPolicyId], references: [id], onDelete: Cascade)
  suppressedByRule DataQualitySuppressionRule? @relation("RenewalSuggestionSuppressionRule", fields: [suppressedByRuleId], references: [id], onDelete: SetNull)
  duplicateOf      PolicyRenewalSuggestion?    @relation("RenewalSuggestionDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       PolicyRenewalSuggestion[]   @relation("RenewalSuggestionDuplicate")
  mergedBy         User?                       @relation("PolicyRenewalSuggestionMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  reviewedBy       User?                       @relation("PolicyRenewalSuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourcePolicyId, targetPolicyId], map: "PolicyRenewalSuggestion_org_source_target_key")
  @@index([maintenanceRunId])
  @@index([sourcePolicyId])
  @@index([sourcePolicyId, status])
  @@index([targetPolicyId])
  @@index([status])
  @@index([suppressedByRuleId])
  @@index([duplicateOfId])
  @@index([reviewedById])
  @@index([mergedById])
  @@index([createdAt])
  @@index([organizationId])
}

