generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("AGENT")
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdClients     Client[]    @relation("ClientCreatedBy")
  updatedClients     Client[]    @relation("ClientUpdatedBy")
  createdPolicies    Policy[]    @relation("PolicyCreatedBy")
  updatedPolicies    Policy[]    @relation("PolicyUpdatedBy")
  createdReceipts    Receipt[]   @relation("ReceiptCreatedBy")
  updatedReceipts    Receipt[]   @relation("ReceiptUpdatedBy")
  createdPayments    Payment[]   @relation("PaymentCreatedBy")
  updatedPayments    Payment[]   @relation("PaymentUpdatedBy")
  createdClaims      Claim[]     @relation("ClaimCreatedBy")
  updatedClaims      Claim[]     @relation("ClaimUpdatedBy")
  createdQuotes      Quote[]     @relation("QuoteCreatedBy")
  updatedQuotes      Quote[]     @relation("QuoteUpdatedBy")
  createdTasks       Task[]      @relation("TaskCreatedBy")
  updatedTasks       Task[]      @relation("TaskUpdatedBy")
  createdWorkItems   WorkItem[]  @relation("WorkItemCreatedBy")
  updatedWorkItems   WorkItem[]  @relation("WorkItemUpdatedBy")
  createdDocuments   Document[]  @relation("DocumentCreatedBy")
  updatedDocuments   Document[]  @relation("DocumentUpdatedBy")
  notificationChannels    NotificationChannel[]    @relation("NotificationChannelUser")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceUser")
  notificationEvents      NotificationEvent[]      @relation("NotificationEventUser")
  telegramLinkTokens      TelegramLinkToken[]      @relation("TelegramLinkTokenUser")

  @@index([email])
  @@index([role])
  @@index([active])
}

model Client {
  id                     String       @id @default(cuid())
  fullName               String
  type                   String       @default("PERSON")
  email                  String?
  phone                  String?
  secondaryPhone         String?
  rfc                    String?
  address                String?
  preferredContactMethod String?
  referidorId            String?
  notes                  String?
  status                 String       @default("ACTIVE")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  createdById            String?
  updatedById            String?

  createdBy   User?        @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  referidor   Client?      @relation("ClientReferidor", fields: [referidorId], references: [id], onDelete: SetNull)
  referidos   Client[]     @relation("ClientReferidor")
  policies    Policy[]
  receipts    Receipt[]
  payments    Payment[]
  commissions Commission[]
  tasks       Task[]
  claims      Claim[]
  quotes      Quote[]
  documents   Document[]
  workItems   WorkItem[]
  notificationEvents NotificationEvent[]

  @@index([fullName])
  @@index([status])
  @@index([referidorId])
  @@index([createdById])
  @@index([updatedById])
}

model Insurer {
  id             String       @id @default(cuid())
  name           String
  portalUrl      String?
  agentPortalUrl String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  policies    Policy[]
  receipts    Receipt[]
  commissions Commission[]
  tasks       Task[]
  claims      Claim[]
  quotes      Quote[]
  workItems   WorkItem[]

  @@index([name])
  @@index([status])
}

model Policy {
  id              String           @id @default(cuid())
  policyNumber    String
  clientId        String
  insurerId       String
  policyType      String
  status          String           @default("ACTIVE")
  startDate       DateTime
  endDate         DateTime
  premiumAmount   Decimal
  currency        String           @default("MXN")
  paymentFrequency String
  paymentPlan     String?
  insuredObject   String?
  beneficiaryInfo String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  familyRootId    String?

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer     Insurer      @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  familyRoot  Policy?      @relation("PolicyFamily", fields: [familyRootId], references: [id], onDelete: SetNull)
  familyPolicies Policy[]   @relation("PolicyFamily")
  receipts    Receipt[]
  payments    Payment[]
  commissions Commission[]
  tasks       Task[]
  claims      Claim[]
  documents   Document[]
  workItems   WorkItem[]
  notificationEvents NotificationEvent[]

  @@index([policyNumber])
  @@index([clientId])
  @@index([insurerId])
  @@index([policyType])
  @@index([status])
  @@index([endDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([familyRootId])
}

model Receipt {
  id              String        @id @default(cuid())
  receiptNumber   String
  policyId        String
  clientId        String
  insurerId       String
  periodStartDate DateTime
  periodEndDate   DateTime
  dueDate         DateTime
  amount          Decimal
  currency        String        @default("MXN")
  status          String        @default("PENDING")
  paidDate        DateTime?
  paymentMethod   String?
  documentId      String?       @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  updatedById     String?

  policy     Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer    Insurer    @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  document   Document?  @relation("ReceiptPrimaryDocument", fields: [documentId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?      @relation("ReceiptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments   Payment[]
  commissions Commission[]
  tasks      Task[]
  documents  Document[] @relation("ReceiptDocuments")
  workItems  WorkItem[]
  notificationEvents NotificationEvent[]

  @@index([receiptNumber])
  @@index([policyId])
  @@index([clientId])
  @@index([insurerId])
  @@index([status])
  @@index([dueDate])
  @@index([paidDate])
  @@index([policyId, receiptNumber])
  @@index([createdById])
  @@index([updatedById])
}

model Payment {
  id            String   @id @default(cuid())
  receiptId     String
  policyId      String
  clientId      String
  amount        Decimal
  currency      String   @default("MXN")
  paidDate      DateTime
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?

  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  policy    Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([policyId])
  @@index([clientId])
  @@index([paidDate])
  @@index([createdById])
  @@index([updatedById])
}

model Commission {
  id             String           @id @default(cuid())
  policyId       String
  receiptId      String?
  clientId       String
  insurerId      String
  expectedAmount Decimal
  actualAmount   Decimal?
  percentage     Decimal?
  status         String           @default("EXPECTED")
  expectedDate   DateTime
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  policy  Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer Insurer  @relation(fields: [insurerId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([receiptId])
  @@index([clientId])
  @@index([insurerId])
  @@index([status])
  @@index([expectedDate])
}

model Task {
  id          String     @id @default(cuid())
  folio       String
  clientId    String?
  policyId    String?
  insurerId   String?
  receiptId   String?
  title       String
  description String?
  taskType    String     @default("GENERAL")
  status      String     @default("OPEN")
  priority    String     @default("MEDIUM")
  startDate   DateTime   @default(now())
  dueDate     DateTime?
  closedDate  DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  updatedById String?

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy    Policy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  insurer   Insurer?   @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  receipt   Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([folio])
  @@index([clientId])
  @@index([policyId])
  @@index([insurerId])
  @@index([receiptId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([updatedById])
}

model WorkItem {
  id          String         @id @default(cuid())
  sourceType  String?
  sourceId    String?
  workItemType String         @default("TASK")
  taskType    String?
  status      String          @default("OPEN")
  priority    String          @default("MEDIUM")
  severity    String?
  folio       String?
  title       String
  description String?
  entityType  String
  entityId    String
  clientId    String?
  policyId    String?
  insurerId   String?
  receiptId   String?
  startDate   DateTime        @default(now())
  dueDate     DateTime?
  closedDate  DateTime?
  readAt      DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?
  updatedById String?

  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy    Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  insurer   Insurer?  @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  receipt   Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("WorkItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("WorkItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  notificationEvents NotificationEvent[]

  @@unique([sourceType, sourceId])
  @@index([folio])
  @@index([entityType, entityId])
  @@index([taskType])
  @@index([clientId])
  @@index([policyId])
  @@index([insurerId])
  @@index([receiptId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([updatedById])
}

model Claim {
  id            String      @id @default(cuid())
  folio         String
  clientId      String
  policyId      String
  insurerId     String
  claimType     String
  description   String?
  status        String      @default("OPEN")
  incidentDate  DateTime
  reportedDate  DateTime
  closedDate    DateTime?
  amountClaimed Decimal?
  amountPaid    Decimal?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?
  updatedById   String?

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policy    Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  insurer   Insurer    @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("ClaimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("ClaimUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([folio])
  @@index([clientId])
  @@index([policyId])
  @@index([insurerId])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

model Quote {
  id            String      @id @default(cuid())
  clientId      String
  insurerId     String?
  policyType    String
  status        String      @default("REQUESTED")
  requestedDate DateTime
  sentDate      DateTime?
  validUntil    DateTime?
  quotedAmount  Decimal?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?
  updatedById   String?

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer   Insurer?   @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([clientId])
  @@index([insurerId])
  @@index([policyType])
  @@index([status])
  @@index([validUntil])
  @@index([createdById])
  @@index([updatedById])
}

model Document {
  id           String       @id @default(cuid())
  clientId     String?
  policyId     String?
  receiptId    String?
  taskId       String?
  claimId      String?
  quoteId      String?
  documentType String       @default("OTHER")
  fileName     String
  filePath     String
  mimeType     String
  uploadedAt   DateTime     @default(now())
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?
  updatedById  String?

  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy         Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  receipt        Receipt? @relation("ReceiptDocuments", fields: [receiptId], references: [id], onDelete: SetNull)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  claim          Claim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  quote          Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  primaryReceipt Receipt? @relation("ReceiptPrimaryDocument")
  createdBy      User?    @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?    @relation("DocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([policyId])
  @@index([receiptId])
  @@index([taskId])
  @@index([claimId])
  @@index([quoteId])
  @@index([documentType])
  @@index([uploadedAt])
  @@index([createdById])
  @@index([updatedById])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
  userId     String

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model NotificationChannel {
  id             String                @id @default(cuid())
  userId         String
  type           String
  telegramChatId String?
  isEnabled      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user User @relation("NotificationChannelUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([telegramChatId])
}

model NotificationPreference {
  id              String                @id @default(cuid())
  userId          String
  eventType       String
  channelType     String
  enabled         Boolean               @default(true)
  minPriority     String                @default("MEDIUM")
  quietHoursStart  String?
  quietHoursEnd    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user User @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channelType])
  @@index([userId])
  @@index([eventType])
  @@index([channelType])
}

model NotificationEvent {
  id          String                @id @default(cuid())
  type        String
  title       String
  body        String
  priority    String                @default("MEDIUM")
  userId      String
  workItemId  String?
  clientId    String?
  policyId    String?
  receiptId   String?
  channelType String               
  status      String               @default("PENDING")
  sentAt      DateTime?
  error       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user    User     @relation("NotificationEventUser", fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy   Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  receipt  Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([channelType])
  @@index([status])
  @@index([createdAt])
  @@index([workItemId])
  @@index([clientId])
  @@index([policyId])
  @@index([receiptId])
}

model TelegramLinkToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt  DateTime
  usedAt    DateTime?
  createdAt  DateTime @default(now())

  user User @relation("TelegramLinkTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Alert {
  id          String        @id @default(cuid())
  alertType   String
  severity    String
  title       String
  description String?
  entityType  String
  entityId    String
  status      String        @default("OPEN")
  readAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([alertType])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@index([readAt])
  @@index([status, readAt])
}
