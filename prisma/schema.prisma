generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Domain status enums. These mirror the constants in src/lib/domain-values.ts;
// the database is the last line of defence so a typo in a script or an import
// can no longer create a phantom state that no screen knows how to render.
// ---------------------------------------------------------------------------

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PolicyStatus {
  ACTIVE
  PENDING
  RENEWED
  EXPIRED
  CANCELLED
}

enum EndorsementStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum CommissionStatus {
  EXPECTED
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ClaimStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_INSURER
  RESOLVED
  CANCELLED
}

enum ClaimChecklistStatus {
  MISSING
  REQUESTED
  RECEIVED
  WAIVED
}

enum KnowledgeSourceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  REQUESTED
  IN_PROGRESS
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_INSURER
  WAITING_DOCUMENT
  SENT
  RESOLVED
  CANCELLED
  ARCHIVED
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_INSURER
  WAITING_DOCUMENT
  SENT
  RESOLVED
  CANCELLED
  ARCHIVED
  DISMISSED
}

enum AlertStatus {
  OPEN
  DISMISSED
  RESOLVED
}

/// Etapa de avance de la renovación en el tablero. Es estado del proceso
/// comercial, no del contrato: la elegibilidad y la cadena de renovación
/// siguen viviendo en PolicyStatus / renewedFromPolicyId.
enum RenewalStage {
  PENDING
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Cycle 1 transition singleton. The PostgreSQL migration owns the temporary
/// trigger/index implementation; these models expose the additive data shape.
model Organization {
  id              String    @id
  name            String
  slug            String    @unique
  kind            String    @default("CUSTOMER")
  status          String    @default("ACTIVE")
  timeZone        String    @default("Etc/GMT+6")
  defaultCurrency String    @default("MXN")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  activatedAt     DateTime?

  memberships                 OrganizationMembership[]
  clients                     Client[]
  insurers                    Insurer[]
  policies                    Policy[]
  receipts                    Receipt[]
  policyEndorsements          PolicyEndorsement[]
  payments                    Payment[]
  commissions                 Commission[]
  tasks                       Task[]
  workItems                   WorkItem[]
  claims                      Claim[]
  claimChecklistItems         ClaimChecklistItem[]
  quotes                      Quote[]
  documents                   Document[]
  activityLogs                ActivityLog[]
  assistantActionDrafts       AssistantActionDraft[]
  notificationPreferences     NotificationPreference[]
  notificationEvents          NotificationEvent[]
  policyInsuredParties        PolicyInsuredParty[]
  policyInsuredAssets         PolicyInsuredAsset[]
  telegramLinkTokens          TelegramLinkToken[]
  ledgerImportBatches         LedgerImportBatch[]
  ledgerImportRows            LedgerImportRow[]
  ledgerImportActions         LedgerImportAction[]
  ledgerImportIssues          LedgerImportIssue[]
  telegramDrafts              TelegramDraft[]
  maintenanceRuns             MaintenanceRun[]
  receiptReconciliationIssues ReceiptReconciliationIssue[]
  policyRenewalSuggestions    PolicyRenewalSuggestion[]
  dataQualitySuppressionRules DataQualitySuppressionRule[]
  assistantReports            AssistantReport[]
  assistantReportSignals      AssistantReportSignal[]
  assistantAiRuns             AssistantAiRun[]
  assistantAiAttempts         AssistantAiAttempt[]
  knowledgeSources            KnowledgeSource[]
  knowledgeChunks             KnowledgeChunk[]
  alerts                      Alert[]
  commissionStatements        CommissionStatement[]
  commissionCorrections       CommissionCorrection[]
  quoteComparisons            QuoteComparison[]
  securityEventAggregates     SecurityEventAggregate[]
  platformAuditTargets        PlatformAuditLog[]           @relation("PlatformAuditTargetOrganization")
  backupArtifacts             BackupArtifact[]
  organizationRestoreRuns     OrganizationRestoreRun[]
  billingSubscriptions        OrganizationSubscription[]
  billingCharges              BillingCharge[]
  capabilities                OrganizationCapability[]
  settings                    OrganizationSetting[]
  currencyRates               CurrencyRate[]
  demoState                   DemoOrganizationState?
  demoUploadArtifacts         DemoUploadArtifact[]
  commissionStatementRows     CommissionStatementRow[]
  quoteComparisonItems        QuoteComparisonItem[]

  @@index([status])
  @@index([kind])
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([userId])
  @@index([organizationId])
  @@index([role])
  @@index([active])
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  name                         String
  phone                        String?
  passwordHash                 String
  role                         String    @default("AGENT")
  platformRole                 String    @default("NONE")
  active                       Boolean   @default(true)
  lastLoginAt                  DateTime?
  mustChangePassword           Boolean   @default(false)
  temporaryPasswordExpiresAt   DateTime?
  sessionVersion               Int       @default(0)
  timeZone                     String    @default("Etc/GMT+6")
  telegramDigestHour           Int       @default(8)
  telegramDigestLastSentAt     DateTime?
  telegramDigestLastAutoSentAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  portfolioClients                    Client[]                     @relation("ClientPortfolioOwner")
  createdClients                      Client[]                     @relation("ClientCreatedBy")
  updatedClients                      Client[]                     @relation("ClientUpdatedBy")
  createdPolicies                     Policy[]                     @relation("PolicyCreatedBy")
  updatedPolicies                     Policy[]                     @relation("PolicyUpdatedBy")
  renewalStagePolicies                Policy[]                     @relation("PolicyRenewalStageBy")
  createdEndorsements                 PolicyEndorsement[]          @relation("PolicyEndorsementCreatedBy")
  updatedEndorsements                 PolicyEndorsement[]          @relation("PolicyEndorsementUpdatedBy")
  createdReceipts                     Receipt[]                    @relation("ReceiptCreatedBy")
  updatedReceipts                     Receipt[]                    @relation("ReceiptUpdatedBy")
  createdPayments                     Payment[]                    @relation("PaymentCreatedBy")
  updatedPayments                     Payment[]                    @relation("PaymentUpdatedBy")
  reversedPayments                    Payment[]                    @relation("PaymentReversedBy")
  createdClaims                       Claim[]                      @relation("ClaimCreatedBy")
  updatedClaims                       Claim[]                      @relation("ClaimUpdatedBy")
  assignedClaims                      Claim[]                      @relation("ClaimAssignedTo")
  createdQuotes                       Quote[]                      @relation("QuoteCreatedBy")
  updatedQuotes                       Quote[]                      @relation("QuoteUpdatedBy")
  createdTasks                        Task[]                       @relation("TaskCreatedBy")
  updatedTasks                        Task[]                       @relation("TaskUpdatedBy")
  createdWorkItems                    WorkItem[]                   @relation("WorkItemCreatedBy")
  updatedWorkItems                    WorkItem[]                   @relation("WorkItemUpdatedBy")
  assignedWorkItems                   WorkItem[]                   @relation("WorkItemAssignedTo")
  assignedClaimChecklistItems         ClaimChecklistItem[]         @relation("ClaimChecklistAssignedTo")
  createdDocuments                    Document[]                   @relation("DocumentCreatedBy")
  updatedDocuments                    Document[]                   @relation("DocumentUpdatedBy")
  notificationChannels                NotificationChannel[]        @relation("NotificationChannelUser")
  notificationPreferences             NotificationPreference[]     @relation("NotificationPreferenceUser")
  notificationEvents                  NotificationEvent[]          @relation("NotificationEventUser")
  telegramLinkTokens                  TelegramLinkToken[]          @relation("TelegramLinkTokenUser")
  telegramDrafts                      TelegramDraft[]              @relation("TelegramDraftUser")
  createdMaintenanceRuns              MaintenanceRun[]             @relation("MaintenanceRunCreatedBy")
  reviewedReceiptIssues               ReceiptReconciliationIssue[] @relation("ReceiptReconciliationIssueReviewedBy")
  mergedReceiptIssues                 ReceiptReconciliationIssue[] @relation("ReceiptReconciliationIssueMergedBy")
  reviewedRenewalSuggestions          PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionReviewedBy")
  mergedRenewalSuggestions            PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionMergedBy")
  createdLedgerImportBatches          LedgerImportBatch[]          @relation("LedgerImportBatchCreatedBy")
  approvedLedgerImportBatches         LedgerImportBatch[]          @relation("LedgerImportBatchApprovedBy")
  createdCommissionStatements         CommissionStatement[]        @relation("CommissionStatementCreatedBy")
  approvedCommissionStatements        CommissionStatement[]        @relation("CommissionStatementApprovedBy")
  performedCommissionCorrections      CommissionCorrection[]       @relation("CommissionCorrectionActor")
  createdQuoteComparisons             QuoteComparison[]            @relation("QuoteComparisonCreatedBy")
  reviewedLedgerImportIssues          LedgerImportIssue[]          @relation("LedgerImportIssueReviewedBy")
  mergedLedgerImportIssues            LedgerImportIssue[]          @relation("LedgerImportIssueMergedBy")
  performedLedgerImportActions        LedgerImportAction[]         @relation("LedgerImportActionPerformedBy")
  createdDataQualitySuppressionRules  DataQualitySuppressionRule[] @relation("DataQualitySuppressionRuleCreatedBy")
  reviewedDataQualitySuppressionRules DataQualitySuppressionRule[] @relation("DataQualitySuppressionRuleReviewedBy")
  createdAssistantActionDrafts        AssistantActionDraft[]       @relation("AssistantActionDraftUser")
  createdAssistantAiRuns              AssistantAiRun[]             @relation("AssistantAiRunUser")
  createdKnowledgeSources             KnowledgeSource[]            @relation("KnowledgeSourceCreatedBy")
  organizationMemberships             OrganizationMembership[]
  platformAuditLogs                   PlatformAuditLog[]           @relation("PlatformAuditActor")
  sessions                            Session[]
  userPreferences                     UserPreference[]
  demoUploadArtifacts                 DemoUploadArtifact[]

  @@index([email])
  @@index([role])
  @@index([active])
  @@index([platformRole])
}

/// Global catalog for platform plans. This is not a customer policy product.
model Plan {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  code               String   @unique
  name               String
  monthlyAmountMinor Int
  currency           String   @db.VarChar(3)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  subscriptions OrganizationSubscription[]

  @@index([active])
}

/// Organization-scoped platform subscription snapshot.
model OrganizationSubscription {
  id                 String    @id @default(cuid())
  requestId          String    @unique
  organizationId     String
  planId             String
  status             String    @default("TRIAL")
  startedAt          DateTime  @default(now())
  endsAt             DateTime?
  monthlyAmountMinor Int
  currency           String    @db.VarChar(3)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges      BillingCharge[]

  @@index([organizationId, status])
  @@index([organizationId])
  @@index([planId])
  @@index([startedAt])
}

/// Internal platform charge ledger. It is not a policy premium/payment ledger.
model BillingCharge {
  id                String    @id @default(cuid())
  requestId         String    @unique
  organizationId    String
  subscriptionId    String?
  periodStart       DateTime
  periodEnd         DateTime
  amountMinor       Int
  currency          String    @db.VarChar(3)
  status            String    @default("PENDING")
  paidAt            DateTime?
  externalReference String?
  reason            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, periodStart])
  @@index([organizationId])
  @@index([organizationId, status, paidAt])
  @@index([subscriptionId])
}

model Client {
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                     String       @id @default(cuid())
  fullName               String
  type                   String       @default("PERSON")
  email                  String?
  phone                  String?
  secondaryPhone         String?
  rfc                    String?
  address                String?
  birthDate              DateTime?    @db.Date
  preferredContactMethod String?
  referidorId            String?
  notes                  String?
  status                 EntityStatus @default(ACTIVE)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  createdById            String?
  updatedById            String?
  portfolioOwnerId       String?

  createdBy          User?               @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  portfolioOwner     User?               @relation("ClientPortfolioOwner", fields: [portfolioOwnerId], references: [id], onDelete: SetNull)
  referidor          Client?             @relation("ClientReferidor", fields: [referidorId], references: [id], onDelete: SetNull)
  referidos          Client[]            @relation("ClientReferidor")
  policies           Policy[]
  receipts           Receipt[]
  payments           Payment[]
  commissions        Commission[]
  tasks              Task[]
  claims             Claim[]
  quotes             Quote[]
  quoteComparisons   QuoteComparison[]
  documents          Document[]
  workItems          WorkItem[]
  notificationEvents NotificationEvent[]
  alerts             Alert[]

  @@index([fullName])
  @@index([status])
  @@index([referidorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([portfolioOwnerId])
  @@index([organizationId])
}

/// Platform-global audit trail for SUPERADMIN operations.
model PlatformAuditLog {
  id                   String   @id @default(cuid())
  requestId            String?  @unique
  actorUserId          String?
  targetOrganizationId String?
  targetUserId         String?
  action               String
  reason               String?
  metadataJson         String?
  createdAt            DateTime @default(now())

  actor              User?         @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetOrganization Organization? @relation("PlatformAuditTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetOrganizationId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model Insurer {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  name           String
  portalUrl      String?
  agentPortalUrl String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  policies    Policy[]
  receipts    Receipt[]
  commissions Commission[]
  tasks       Task[]
  claims      Claim[]
  quotes      Quote[]
  workItems   WorkItem[]

  @@index([name])
  @@index([status])
  @@index([organizationId])
}

model Policy {
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                        String       @id @default(cuid())
  policyNumber              String
  clientId                  String
  insurerId                 String
  policyType                String
  status                    PolicyStatus @default(ACTIVE)
  startDate                 DateTime
  endDate                   DateTime
  premiumAmount             Decimal
  currency                  String       @default("MXN")
  paymentFrequency          String
  paymentPlan               String?
  insuredObject             String?
  riskDetails               Json?
  riskDetailsReviewRequired Boolean      @default(false)
  beneficiaryInfo           String?
  notes                     String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  createdById               String?
  updatedById               String?
  familyRootId              String?
  renewedFromPolicyId       String?
  isMultiYearContract       Boolean      @default(false)
  cancellationReason        String?
  cancellationBatchId       String?
  cancelledAt               DateTime?
  renewalStage              RenewalStage @default(PENDING)
  renewalStageAt            DateTime?
  renewalStageById          String?

  renewalStageBy              User?                        @relation("PolicyRenewalStageBy", fields: [renewalStageById], references: [id], onDelete: SetNull)
  client                      Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer                     Insurer                      @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  createdBy                   User?                        @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                   User?                        @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  familyRoot                  Policy?                      @relation("PolicyFamily", fields: [familyRootId], references: [id], onDelete: SetNull)
  familyPolicies              Policy[]                     @relation("PolicyFamily")
  renewedFrom                 Policy?                      @relation("PolicyRenewalChain", fields: [renewedFromPolicyId], references: [id], onDelete: SetNull)
  renewals                    Policy[]                     @relation("PolicyRenewalChain")
  endorsements                PolicyEndorsement[]
  receipts                    Receipt[]
  payments                    Payment[]
  commissions                 Commission[]
  tasks                       Task[]
  claims                      Claim[]
  documents                   Document[]
  workItems                   WorkItem[]
  notificationEvents          NotificationEvent[]
  receiptReconciliationIssues ReceiptReconciliationIssue[]
  insuredParties              PolicyInsuredParty[]
  insuredAssets               PolicyInsuredAsset[]
  sourceRenewalSuggestions    PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionSource")
  targetRenewalSuggestions    PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionTarget")
  alerts                      Alert[]

  @@index([policyNumber])
  @@index([clientId])
  @@index([insurerId])
  @@index([policyType])
  @@index([status])
  @@index([endDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([familyRootId])
  @@index([renewedFromPolicyId])
  @@index([cancellationBatchId])
  @@index([organizationId])
  @@index([renewalStageById])
  @@index([renewalStage, endDate])
  @@index([organizationId, status, endDate])
  @@index([organizationId, status, insurerId])
  @@index([organizationId, riskDetailsReviewRequired])
}

model Receipt {
  organizationId           String
  organization             Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                       String        @id @default(cuid())
  receiptNumber            String
  /// Numeric suffix used only for stable human ordering; the displayed
  /// receiptNumber remains the source value (for example, REC-001).
  receiptSequence          Int?
  policyId                 String
  endorsementId            String?
  clientId                 String
  insurerId                String
  periodStartDate          DateTime
  periodEndDate            DateTime
  dueDate                  DateTime
  amount                   Decimal
  currency                 String        @default("MXN")
  status                   ReceiptStatus @default(PENDING)
  paidDate                 DateTime?
  paymentMethod            String?
  documentId               String?       @unique
  notes                    String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  createdById              String?
  updatedById              String?
  reconciliationAdjustment Decimal       @default(0)
  reconciliationNote       String?
  cancellationReason       String?
  cancellationBatchId      String?
  cancelledAt              DateTime?

  policy               Policy                       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  endorsement          PolicyEndorsement?           @relation(fields: [endorsementId], references: [id], onDelete: SetNull)
  client               Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer              Insurer                      @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  document             Document?                    @relation("ReceiptPrimaryDocument", fields: [documentId], references: [id], onDelete: SetNull)
  createdBy            User?                        @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                        @relation("ReceiptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments             Payment[]
  commissions          Commission[]
  tasks                Task[]
  documents            Document[]                   @relation("ReceiptDocuments")
  workItems            WorkItem[]
  notificationEvents   NotificationEvent[]
  reconciliationIssues ReceiptReconciliationIssue[]
  alerts               Alert[]

  @@index([receiptNumber])
  @@index([policyId, receiptSequence])
  @@index([policyId])
  @@index([endorsementId])
  @@index([clientId])
  @@index([insurerId])
  @@index([status])
  @@index([dueDate])
  @@index([paidDate])
  @@index([policyId, receiptNumber])
  @@index([createdById])
  @@index([updatedById])
  @@index([cancellationBatchId])
  @@index([organizationId])
  @@index([organizationId, status, dueDate])
}

model PolicyEndorsement {
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                String            @id @default(cuid())
  endorsementNumber String
  policyId          String
  status            EndorsementStatus @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime
  amount            Decimal
  currency          String            @default("MXN")
  reference         String?
  concept           String?
  notes             String?
  documentId        String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?
  updatedById       String?

  policy    Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  document  Document?  @relation("PolicyEndorsementPrimaryDocument", fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("PolicyEndorsementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("PolicyEndorsementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  receipts  Receipt[]
  documents Document[] @relation("PolicyEndorsementDocuments")

  @@unique([policyId, endorsementNumber])
  @@index([policyId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([organizationId])
}

model Payment {
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                String        @id @default(cuid())
  receiptId         String
  policyId          String
  clientId          String
  amount            Decimal
  currency          String        @default("MXN")
  status            PaymentStatus @default(POSTED)
  paidDate          DateTime
  paymentMethod     String?
  reference         String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  updatedById       String?
  reversedById      String?
  reversedAt        DateTime?
  reversalReason    String?
  sourceEvidenceKey String?

  receipt    Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  policy     Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy  User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?   @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reversedBy User?   @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceEvidenceKey])
  @@index([receiptId])
  @@index([policyId])
  @@index([clientId])
  @@index([paidDate])
  @@index([status])
  @@index([reversedById])
  @@index([createdById])
  @@index([updatedById])
  @@index([organizationId])
}

model Commission {
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String           @id @default(cuid())
  policyId       String
  receiptId      String?
  clientId       String
  insurerId      String
  expectedAmount Decimal
  actualAmount   Decimal?
  percentage     Decimal?
  status         CommissionStatus @default(EXPECTED)
  expectedDate   DateTime
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  version        Int              @default(1)

  policy        Policy                   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  receipt       Receipt?                 @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  client        Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer       Insurer                  @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  statementRows CommissionStatementRow[]
  corrections   CommissionCorrection[]

  @@index([policyId])
  @@index([receiptId])
  @@index([clientId])
  @@index([insurerId])
  @@index([status])
  @@index([expectedDate])
  @@index([organizationId])
  @@index([organizationId, status, expectedDate])
}

model Task {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  folio          String
  clientId       String?
  policyId       String?
  insurerId      String?
  receiptId      String?
  title          String
  description    String?
  taskType       String       @default("GENERAL")
  status         TaskStatus   @default(OPEN)
  priority       String       @default("MEDIUM")
  startDate      DateTime     @default(now())
  dueDate        DateTime?
  closedDate     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  version        Int          @default(1)
  createdById    String?
  updatedById    String?

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
