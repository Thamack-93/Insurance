model DemoOrganizationState {
  organizationId      String    @id
  seedVersion         String
  trialEndsAt         DateTime
  realDataResetAt     DateTime?
  lastResetAt         DateTime?
  resetStatus         String    @default("IDLE")
  resetPhase          String    @default("IDLE")
  resetAttemptId      String?   @unique
  resetRequestId      String?
  resetStartedAt      DateTime?
  resetHeartbeatAt    DateTime?
  resetLeaseExpiresAt DateTime?
  resetAttempts       Int       @default(0)
  resetFailure        String?
  dataVersion         Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([trialEndsAt, resetStatus])
  @@index([realDataResetAt])
  @@index([resetStatus, resetLeaseExpiresAt])
}

