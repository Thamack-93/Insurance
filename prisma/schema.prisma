/// Tenant-owned insurance knowledge. Content is chunked before it can be
/// retrieved by Nora; the source file itself remains outside the model.
model KnowledgeSource {
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                  String                @id @default(cuid())
  title               String
  insurerName         String?
  product             String?
  version             String
  status              KnowledgeSourceStatus @default(DRAFT)
  sourceUrl           String?
  authority           String?
  reviewedAt          DateTime?
  effectiveFrom       DateTime?             @db.Date
  effectiveTo         DateTime?             @db.Date
  contentHash         String
  manifestHash        String?
  integrityVersion    String?               @default("CHUNK_MANIFEST_V1")
  integrityVerifiedAt DateTime?
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  createdBy User?            @relation("KnowledgeSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  chunks    KnowledgeChunk[]

  @@unique([organizationId, contentHash])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, insurerName, product])
  @@index([createdById])
}

