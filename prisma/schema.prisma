  deletedAt             DateTime?
  lastPurgeAt           DateTime?
  blobDeleteConfirmedAt DateTime?
  purgeBreachAt         DateTime?
  dataVersion           Int       @default(1)
  status                String    @default("ACTIVE")
  sizeBytes             Int?
  sha256                String?
  detectedMimeType      String?
  validationStatus      String    @default("ACCEPTED")
  validatedAt           DateTime?
  purgeAttempts         Int       @default(0)
  lastPurgeFailureCode  String?

