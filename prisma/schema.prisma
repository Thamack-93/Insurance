  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt, status])
  @@index([organizationId, purgeAfterAt, status])
  @@index([userId, uploadedAt])
  @@index([organizationId, validationStatus, status])
}

