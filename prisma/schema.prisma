  errorMessage       String?
  statusCode         Int?
  finishReason       String?
  usageJson          String?
  totalUsageJson     String?
  providerMetadataJson String?
  responsePreview    String?
  estimatedCostUsd   Decimal?
  durationMs         Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User             @relation("AssistantAiRunUser", fields: [userId], references: [id], onDelete: Cascade)
  report             AssistantReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  attempts           AssistantAiAttempt[]

  @@index([userId])
  @@index([userRole])
  @@index([operation])
  @@index([tier])
  @@index([status])
  @@index([requestedModel])
  @@index([finalModel])
  @@index([reportId])
  @@index([createdAt])
  @@index([organizationId])
}

model AssistantAiAttempt {
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                 String    @id @default(cuid())
  runId              String
  attemptNumber      Int
  tier               String
  requestedModel     String
  finalModel         String?
  status             String    @default("STARTED")
  fallbackReason     String?
  provider           String?
  errorCode          String?
  errorMessage       String?
  statusCode         Int?
  finishReason       String?
  responsePreview    String?
  usageJson          String?
  totalUsageJson     String?
  providerMetadataJson String?
  durationMs         Int?
  estimatedCostUsd   Decimal?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  run                AssistantAiRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([attemptNumber])
  @@index([tier])
  @@index([status])
  @@index([requestedModel])
  @@index([finalModel])
  @@index([createdAt])
  @@index([organizationId])
}

model Alert {
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  alertType   String
  severity    String
  title       String
  description String?
  /// Free-form discriminator kept for non-relational subjects (SecurityEvent,
  /// System, ...). When the subject is a record we own, the typed column below
  /// is the authoritative link and carries the referential integrity.
  entityType  String
  entityId    String
  clientId    String?
  policyId    String?
  receiptId   String?
  status      AlertStatus @default(OPEN)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policy    Policy?    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  receipt   Receipt?   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  workItems WorkItem[] @relation("WorkItemSourceAlert")

  @@index([clientId])
  @@index([policyId])
  @@index([receiptId])
  @@index([alertType])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@index([readAt])
  @@index([status, readAt])
  @@index([organizationId])
}

model SecurityEventAggregate {
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id              String   @id @default(cuid())
  alertType       String
  fingerprint     String
  windowStart     DateTime
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  occurrenceCount Int      @default(1)
  title           String
  description     String?
  severity        String

  @@unique([alertType, fingerprint, windowStart])
  @@index([alertType])
  @@index([lastSeenAt])
  @@index([organizationId])
}

model TelegramWebhookUpdate {
  id         String   @id @default(cuid())
  updateId   Int      @unique
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}
