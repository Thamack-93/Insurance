generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("AGENT")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  timeZone     String    @default("America/Mexico_City")
  telegramDigestHour    Int       @default(8)
  telegramDigestLastSentAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  portfolioClients           Client[]                     @relation("ClientPortfolioOwner")
  createdClients             Client[]                     @relation("ClientCreatedBy")
  updatedClients             Client[]                     @relation("ClientUpdatedBy")
  createdPolicies            Policy[]                     @relation("PolicyCreatedBy")
  updatedPolicies            Policy[]                     @relation("PolicyUpdatedBy")
  createdReceipts            Receipt[]                    @relation("ReceiptCreatedBy")
  updatedReceipts            Receipt[]                    @relation("ReceiptUpdatedBy")
  createdPayments            Payment[]                    @relation("PaymentCreatedBy")
  updatedPayments            Payment[]                    @relation("PaymentUpdatedBy")
  createdClaims              Claim[]                      @relation("ClaimCreatedBy")
  updatedClaims              Claim[]                      @relation("ClaimUpdatedBy")
  createdQuotes              Quote[]                      @relation("QuoteCreatedBy")
  updatedQuotes              Quote[]                      @relation("QuoteUpdatedBy")
  createdTasks               Task[]                       @relation("TaskCreatedBy")
  updatedTasks               Task[]                       @relation("TaskUpdatedBy")
  createdWorkItems           WorkItem[]                   @relation("WorkItemCreatedBy")
  updatedWorkItems           WorkItem[]                   @relation("WorkItemUpdatedBy")
  assignedWorkItems          WorkItem[]                   @relation("WorkItemAssignedTo")
  createdDocuments           Document[]                   @relation("DocumentCreatedBy")
  updatedDocuments           Document[]                   @relation("DocumentUpdatedBy")
  notificationChannels       NotificationChannel[]        @relation("NotificationChannelUser")
  notificationPreferences    NotificationPreference[]     @relation("NotificationPreferenceUser")
  notificationEvents         NotificationEvent[]          @relation("NotificationEventUser")
  telegramLinkTokens         TelegramLinkToken[]          @relation("TelegramLinkTokenUser")
  telegramDrafts             TelegramDraft[]              @relation("TelegramDraftUser")
  createdMaintenanceRuns     MaintenanceRun[]             @relation("MaintenanceRunCreatedBy")
  reviewedReceiptIssues      ReceiptReconciliationIssue[] @relation("ReceiptReconciliationIssueReviewedBy")
  reviewedRenewalSuggestions PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionReviewedBy")
  createdLedgerImportBatches LedgerImportBatch[]          @relation("LedgerImportBatchCreatedBy")
  approvedLedgerImportBatches LedgerImportBatch[]         @relation("LedgerImportBatchApprovedBy")
  reviewedLedgerImportIssues LedgerImportIssue[]          @relation("LedgerImportIssueReviewedBy")
  performedLedgerImportActions LedgerImportAction[]       @relation("LedgerImportActionPerformedBy")

  @@index([email])
  @@index([role])
  @@index([active])
}

model Client {
  id                     String   @id @default(cuid())
  fullName               String
  type                   String   @default("PERSON")
  email                  String?
  phone                  String?
  secondaryPhone         String?
  rfc                    String?
  address                String?
  preferredContactMethod String?
  referidorId            String?
  notes                  String?
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdById            String?
  updatedById            String?
  portfolioOwnerId       String?

  createdBy          User?               @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  portfolioOwner     User?               @relation("ClientPortfolioOwner", fields: [portfolioOwnerId], references: [id], onDelete: SetNull)
  referidor          Client?             @relation("ClientReferidor", fields: [referidorId], references: [id], onDelete: SetNull)
  referidos          Client[]            @relation("ClientReferidor")
  policies           Policy[]
  receipts           Receipt[]
  payments           Payment[]
  commissions        Commission[]
  tasks              Task[]
  claims             Claim[]
  quotes             Quote[]
  documents          Document[]
  workItems          WorkItem[]
  notificationEvents NotificationEvent[]

  @@index([fullName])
  @@index([status])
  @@index([referidorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([portfolioOwnerId])
}

model Insurer {
  id             String   @id @default(cuid())
  name           String
  portalUrl      String?
  agentPortalUrl String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  policies    Policy[]
  receipts    Receipt[]
  commissions Commission[]
  tasks       Task[]
  claims      Claim[]
  quotes      Quote[]
  workItems   WorkItem[]

  @@index([name])
  @@index([status])
}

model Policy {
  id                  String   @id @default(cuid())
  policyNumber        String
  clientId            String
  insurerId           String
  policyType          String
  status              String   @default("ACTIVE")
  startDate           DateTime
  endDate             DateTime
  premiumAmount       Decimal
  currency            String   @default("MXN")
  paymentFrequency    String
  paymentPlan         String?
  insuredObject       String?
  beneficiaryInfo     String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?
  updatedById         String?
  familyRootId        String?
  renewedFromPolicyId String?
  isMultiYearContract Boolean  @default(false)

  client                      Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer                     Insurer                      @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  createdBy                   User?                        @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                   User?                        @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  familyRoot                  Policy?                      @relation("PolicyFamily", fields: [familyRootId], references: [id], onDelete: SetNull)
  familyPolicies              Policy[]                     @relation("PolicyFamily")
  renewedFrom                 Policy?                      @relation("PolicyRenewalChain", fields: [renewedFromPolicyId], references: [id], onDelete: SetNull)
  renewals                    Policy[]                     @relation("PolicyRenewalChain")
  receipts                    Receipt[]
  payments                    Payment[]
  commissions                 Commission[]
  tasks                       Task[]
  claims                      Claim[]
  documents                   Document[]
  workItems                   WorkItem[]
  notificationEvents          NotificationEvent[]
  receiptReconciliationIssues ReceiptReconciliationIssue[]
  insuredParties              PolicyInsuredParty[]
  insuredAssets               PolicyInsuredAsset[]
  sourceRenewalSuggestions    PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionSource")
  targetRenewalSuggestions    PolicyRenewalSuggestion[]    @relation("PolicyRenewalSuggestionTarget")

  @@index([policyNumber])
  @@index([clientId])
  @@index([insurerId])
  @@index([policyType])
  @@index([status])
  @@index([endDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([familyRootId])
  @@index([renewedFromPolicyId])
}

model Receipt {
  id                       String    @id @default(cuid())
  receiptNumber            String
  policyId                 String
  clientId                 String
  insurerId                String
  periodStartDate          DateTime
  periodEndDate            DateTime
  dueDate                  DateTime
  amount                   Decimal
  currency                 String    @default("MXN")
  status                   String    @default("PENDING")
  paidDate                 DateTime?
  paymentMethod            String?
  documentId               String?   @unique
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdById              String?
  updatedById              String?
  reconciliationAdjustment Decimal   @default(0)
  reconciliationNote       String?

  policy               Policy                       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  client               Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer              Insurer                      @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  document             Document?                    @relation("ReceiptPrimaryDocument", fields: [documentId], references: [id], onDelete: SetNull)
  createdBy            User?                        @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                        @relation("ReceiptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments             Payment[]
  commissions          Commission[]
  tasks                Task[]
  documents            Document[]                   @relation("ReceiptDocuments")
  workItems            WorkItem[]
  notificationEvents   NotificationEvent[]
  reconciliationIssues ReceiptReconciliationIssue[]

  @@index([receiptNumber])
  @@index([policyId])
  @@index([clientId])
  @@index([insurerId])
  @@index([status])
  @@index([dueDate])
  @@index([paidDate])
  @@index([policyId, receiptNumber])
  @@index([createdById])
  @@index([updatedById])
}

model Payment {
  id                String   @id @default(cuid())
  receiptId         String
  policyId          String
  clientId          String
  amount            Decimal
  currency          String   @default("MXN")
  paidDate          DateTime
  paymentMethod     String?
  reference         String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?
  sourceEvidenceKey String?  @unique

  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  policy    Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([policyId])
  @@index([clientId])
  @@index([paidDate])
  @@index([createdById])
  @@index([updatedById])
}

model Commission {
  id             String    @id @default(cuid())
  policyId       String
  receiptId      String?
  clientId       String
  insurerId      String
  expectedAmount Decimal
  actualAmount   Decimal?
  percentage     Decimal?
  status         String    @default("EXPECTED")
  expectedDate   DateTime
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  policy  Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer Insurer  @relation(fields: [insurerId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([receiptId])
  @@index([clientId])
  @@index([insurerId])
  @@index([status])
  @@index([expectedDate])
}

model Task {
  id          String    @id @default(cuid())
  folio       String
  clientId    String?
  policyId    String?
  insurerId   String?
  receiptId   String?
  title       String
  description String?
  taskType    String    @default("GENERAL")
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  startDate   DateTime  @default(now())
  dueDate     DateTime?
  closedDate  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy    Policy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  insurer   Insurer?   @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  receipt   Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([folio])
  @@index([clientId])
  @@index([policyId])
  @@index([insurerId])
  @@index([receiptId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([updatedById])
}

model WorkItem {
  id           String    @id @default(cuid())
  sourceType   String?
  sourceId     String?
  workItemType String    @default("TASK")
  taskType     String?
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  severity     String?
  folio        String?
  title        String
  description  String?
  entityType   String
  entityId     String
  clientId     String?
  policyId     String?
  insurerId    String?
  receiptId    String?
  startDate    DateTime  @default(now())
  dueDate      DateTime?
  closedDate   DateTime?
  readAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  assignedToId String?

  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy             Policy?             @relation(fields: [policyId], references: [id], onDelete: SetNull)
  insurer            Insurer?            @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  receipt            Receipt?            @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("WorkItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("WorkItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignedTo         User?               @relation("WorkItemAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  notificationEvents NotificationEvent[]

  @@unique([sourceType, sourceId])
  @@index([folio])
  @@index([entityType, entityId])
  @@index([taskType])
  @@index([clientId])
  @@index([policyId])
  @@index([insurerId])
  @@index([receiptId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([assignedToId])
}

model Claim {
  id            String    @id @default(cuid())
  folio         String
  clientId      String
  policyId      String
  insurerId     String
  claimType     String
  description   String?
  status        String    @default("OPEN")
  incidentDate  DateTime
  reportedDate  DateTime
  closedDate    DateTime?
  amountClaimed Decimal?
  amountPaid    Decimal?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  updatedById   String?

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policy    Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  insurer   Insurer    @relation(fields: [insurerId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("ClaimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("ClaimUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([folio])
  @@index([clientId])
  @@index([policyId])
  @@index([insurerId])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

model Quote {
  id            String    @id @default(cuid())
  clientId      String
  insurerId     String?
  policyType    String
  status        String    @default("REQUESTED")
  requestedDate DateTime
  sentDate      DateTime?
  validUntil    DateTime?
  quotedAmount  Decimal?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  updatedById   String?

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurer   Insurer?   @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([clientId])
  @@index([insurerId])
  @@index([policyType])
  @@index([status])
  @@index([validUntil])
  @@index([createdById])
  @@index([updatedById])
}

model Document {
  id           String   @id @default(cuid())
  clientId     String?
  policyId     String?
  receiptId    String?
  taskId       String?
  claimId      String?
  quoteId      String?
  documentType String   @default("OTHER")
  fileName     String
  filePath     String
  mimeType     String
  uploadedAt   DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  updatedById  String?

  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy         Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  receipt        Receipt? @relation("ReceiptDocuments", fields: [receiptId], references: [id], onDelete: SetNull)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  claim          Claim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  quote          Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  primaryReceipt Receipt? @relation("ReceiptPrimaryDocument")
  createdBy      User?    @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?    @relation("DocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([policyId])
  @@index([receiptId])
  @@index([taskId])
  @@index([claimId])
  @@index([quoteId])
  @@index([documentType])
  @@index([uploadedAt])
  @@index([createdById])
  @@index([updatedById])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
  userId     String

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model NotificationChannel {
  id             String   @id @default(cuid())
  userId         String
  type           String
  telegramChatId String?
  isEnabled      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation("NotificationChannelUser", fields: [userId], references: [id], onDelete: Cascade)
  telegramDrafts TelegramDraft[] @relation("TelegramDraftChannel")

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([telegramChatId])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String
  eventType       String
  channelType     String
  enabled         Boolean  @default(true)
  minPriority     String   @default("MEDIUM")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channelType])
  @@index([userId])
  @@index([eventType])
  @@index([channelType])
}

model NotificationEvent {
  id          String    @id @default(cuid())
  type        String
  title       String
  body        String
  priority    String    @default("MEDIUM")
  userId      String
  workItemId  String?
  clientId    String?
  policyId    String?
  receiptId   String?
  channelType String
  status      String    @default("PENDING")
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation("NotificationEventUser", fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  policy   Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  receipt  Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([channelType])
  @@index([status])
  @@index([createdAt])
  @@index([workItemId])
  @@index([clientId])
  @@index([policyId])
  @@index([receiptId])
}

model PolicyInsuredParty {
  id          String   @id @default(cuid())
  policyId    String
  fullName    String
  isPrimary   Boolean  @default(false)
  sourceLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([fullName])
  @@index([isPrimary])
  @@unique([policyId, fullName])
}

model PolicyInsuredAsset {
  id           String   @id @default(cuid())
  policyId     String
  assetType    String
  description  String
  serialNumber String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([assetType])
  @@index([serialNumber])
  @@index([isPrimary])
  @@unique([policyId, assetType, description, serialNumber], map: "PolicyInsuredAsset_policyId_assetType_description_serialNumber_")
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("TelegramLinkTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model LedgerImportBatch {
  id            String   @id @default(cuid())
  sourceCsvName  String
  sourceCsvHash  String
  sourcePaidName String
  sourcePaidHash String
  status        String   @default("PREVIEW")
  summaryJson   String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  appliedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy      User?              @relation("LedgerImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?              @relation("LedgerImportBatchApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rows           LedgerImportRow[]
  issues         LedgerImportIssue[]
  actions        LedgerImportAction[]

  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
}

model LedgerImportRow {
  id            String   @id @default(cuid())
  batchId       String
  sourceType    String
  rowNumber     Int
  sourceKey     String
  rawJson       String
  normalizedJson String?
  action        String
  status        String   @default("PENDING")
  policyId      String?
  receiptId     String?
  paymentId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch   LedgerImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  actions LedgerImportAction[]
  issues  LedgerImportIssue[]

  @@index([batchId])
  @@index([sourceType])
  @@index([sourceKey])
  @@index([status])
  @@index([policyId])
  @@index([receiptId])
  @@index([paymentId])
}

model LedgerImportAction {
  id            String   @id @default(cuid())
  batchId       String
  rowId         String?
  actionType    String
  payloadJson   String?
  performedById String?
  createdAt     DateTime @default(now())

  batch       LedgerImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  row         LedgerImportRow?  @relation(fields: [rowId], references: [id], onDelete: SetNull)
  performedBy User?             @relation("LedgerImportActionPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([rowId])
  @@index([actionType])
  @@index([performedById])
  @@index([createdAt])
}

model LedgerImportIssue {
  id            String   @id @default(cuid())
  batchId       String
  rowId         String?
  issueType     String
  severity      String
  status        String   @default("OPEN")
  message       String
  detailsJson   String?
  reviewedAt    DateTime?
  reviewedById  String?
  resolutionNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch      LedgerImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  row        LedgerImportRow?  @relation(fields: [rowId], references: [id], onDelete: SetNull)
  reviewedBy User?             @relation("LedgerImportIssueReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([rowId])
  @@index([issueType])
  @@index([severity])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
}

model TelegramDraft {
  id          String    @id @default(cuid())
  userId      String
  channelId   String?
  type        String
  status      String    @default("COLLECTING")
  payloadJson String
  expiresAt   DateTime
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User                 @relation("TelegramDraftUser", fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel? @relation("TelegramDraftChannel", fields: [channelId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([channelId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status])
}

model MaintenanceRun {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("PENDING")
  summaryJson String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy                   User?                        @relation("MaintenanceRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  receiptReconciliationIssues ReceiptReconciliationIssue[]
  policyRenewalSuggestions    PolicyRenewalSuggestion[]

  @@index([type])
  @@index([status])
  @@index([startedAt])
  @@index([createdById])
}

model ReceiptReconciliationIssue {
  id               String    @id @default(cuid())
  maintenanceRunId String?
  receiptId        String?
  policyId         String?
  reason           String
  status           String    @default("OPEN")
  detailsJson      String?
  expectedAmount   Decimal?
  paidAmount       Decimal?
  reviewedAt       DateTime?
  reviewedById     String?
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maintenanceRun MaintenanceRun? @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  receipt        Receipt?        @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  policy         Policy?         @relation(fields: [policyId], references: [id], onDelete: SetNull)
  reviewedBy     User?           @relation("ReceiptReconciliationIssueReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([maintenanceRunId])
  @@index([receiptId])
  @@index([policyId])
  @@index([reason])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
}

model PolicyRenewalSuggestion {
  id               String    @id @default(cuid())
  maintenanceRunId String?
  sourcePolicyId   String
  targetPolicyId   String?
  status           String    @default("PENDING")
  confidence       Decimal?
  reason           String?
  reviewedAt       DateTime?
  reviewedById     String?
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maintenanceRun MaintenanceRun? @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  sourcePolicy   Policy          @relation("PolicyRenewalSuggestionSource", fields: [sourcePolicyId], references: [id], onDelete: Cascade)
  targetPolicy   Policy?         @relation("PolicyRenewalSuggestionTarget", fields: [targetPolicyId], references: [id], onDelete: Cascade)
  reviewedBy     User?           @relation("PolicyRenewalSuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([sourcePolicyId, targetPolicyId])
  @@index([maintenanceRunId])
  @@index([sourcePolicyId])
  @@index([sourcePolicyId, status])
  @@index([targetPolicyId])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
}

model Alert {
  id          String    @id @default(cuid())
  alertType   String
  severity    String
  title       String
  description String?
  entityType  String
  entityId    String
  status      String    @default("OPEN")
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([alertType])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@index([readAt])
  @@index([status, readAt])
}
