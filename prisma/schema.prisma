model Alert {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id             String       @id @default(cuid())
  alertType      String
  severity       String
  title          String
  description    String?
  /// Free-form discriminator kept for non-relational subjects (SecurityEvent,
  /// System, ...). When the subject is a record we own, the typed column below
  /// is the authoritative link and carries the referential integrity.
  entityType     String
  entityId       String
  clientId       String?
  policyId       String?
  receiptId      String?
  status         AlertStatus  @default(OPEN)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policy    Policy?    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  receipt   Receipt?   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  workItems WorkItem[] @relation("WorkItemSourceAlert")

  @@index([clientId])
  @@index([policyId])
  @@index([receiptId])
  @@index([alertType])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@index([readAt])
  @@index([status, readAt])
  @@index([organizationId])
}

