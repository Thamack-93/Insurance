/// Platform-controlled backup catalog. These rows are never part of a tenant
/// snapshot restore; tenant attribution is authorization metadata.
model BackupArtifact {
  id                String   @id @default(cuid())
  scope             String
  organizationId    String?
  filename          String
  pathname          String   @unique
  storage           String   @default("original")
  size              Int
  createdAt         DateTime
  manifestAvailable Boolean  @default(false)
  formatVersion     Int?
  keyVersion        String?
  payloadSha256     String?
  manifestSha256    String?
  status            String   @default("DISCOVERED")
  capability        String   @default("DATABASE_ONLY")
  sourceArtifactId  String?
  metadataJson      String?
  updatedAt         DateTime @updatedAt

